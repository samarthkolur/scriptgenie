{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scriptgenie.dev/kb/budget_tier.schema.json",
  "title": "Budget tiers and their narrative scope parameters",
  "description": "The mapping that turns a production budget into hard narrative bounds. This is the artifact the research gap identifies as missing: line producers apply it intuitively, but it has never been formalised as machine-readable data.",
  "allOf": [{ "$ref": "common.schema.json#/$defs/envelope" }],
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/budgetTier" }
    }
  },
  "$defs": {
    "budgetTier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "order",
        "range_usd",
        "guild_context",
        "scope",
        "citations"
      ],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/identifier" },
        "label": { "type": "string", "minLength": 3 },
        "order": {
          "type": "integer",
          "minimum": 0,
          "description": "Ascending by budget. Used for comparisons; never compare labels."
        },
        "range_usd": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 0 },
            "max": {
              "type": ["integer", "null"],
              "description": "null means unbounded above."
            }
          }
        },
        "guild_context": {
          "type": "string",
          "description": "The SAG-AFTRA or DGA agreement tier this budget band corresponds to, which is what makes the band meaningful rather than arbitrary."
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_locations",
            "max_named_characters",
            "vfx_complexity",
            "period_setting",
            "action_complexity",
            "narrative_economy"
          ],
          "properties": {
            "max_locations": {
              "type": ["integer", "null"],
              "minimum": 1,
              "description": "Distinct shooting locations. null means bounded by genre convention rather than by budget."
            },
            "max_named_characters": {
              "type": ["integer", "null"],
              "minimum": 1,
              "description": "Named speaking roles, which drive both cast cost and shooting days."
            },
            "vfx_complexity": {
              "$ref": "common.schema.json#/$defs/vfxComplexity"
            },
            "period_setting": {
              "$ref": "common.schema.json#/$defs/periodSetting"
            },
            "action_complexity": {
              "$ref": "common.schema.json#/$defs/actionComplexity"
            },
            "narrative_economy": {
              "type": "string",
              "enum": ["high", "moderate", "standard", "relaxed"],
              "description": "How hard each scene must work. 'high' requires every scene to serve more than one story function, because there is no budget for a scene that does one job."
            }
          }
        },
        "rationale": { "type": "string" },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/citation" }
        }
      }
    }
  }
}
