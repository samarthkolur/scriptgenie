            "sexual_content": 1,
            "language": 2,
            "thematic_darkness": 3,
            "drug_use": 2,
            "horror_intensity": 3
          },
          "criteria": {
            "violence": "Intense sequences permitted, but not sustained graphic violence and not depicted gore.",
            "sexual_content": "Suggestive material permitted; no explicit sexual activity; brief non-sexual nudity at most.",
            "language": "Harsher language permitted in limited quantity and not in a sexual context.",
            "thematic_darkness": "Serious and disturbing themes permitted where not gratuitously dwelt upon.",
            "drug_use": "Drug use may be depicted where not glamorised.",
            "horror_intensity": "Sustained dread and terror permitted without graphic depiction."
          },
          "prohibited_elements": [
            "sustained graphic violence",
            "explicit sexual activity",
            "depicted gore"
