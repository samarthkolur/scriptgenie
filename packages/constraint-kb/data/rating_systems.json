  "equivalences": [
    {
      "classifications": ["mpa.g", "bbfc.u", "cbfc.u", "fsk.fsk_0", "acb.g"],
      "confidence": "high",
      "note": "All-ages classifications align closely across boards."
    },
    {
      "classifications": ["mpa.pg", "bbfc.pg", "fsk.fsk_6", "acb.pg"],
      "confidence": "high",
      "note": "Parental-guidance classifications align closely. CBFC has no direct counterpart between U and U/A."
    },
    {
      "classifications": [
        "mpa.pg_13",
        "bbfc.twelve_a",
        "cbfc.ua",
        "fsk.fsk_12",
        "acb.m"
      ],
      "confidence": "medium",
      "note": "Nominally the same young-teen audience, but not interchangeable. CBFC U/A applies a materially tighter standard on depicted violence and on drug depiction than MPA PG-13, so content cleared at PG-13 in the United States can still attract cuts or reclassification in India. This is the single most consequential approximation in this table."
    },
    {
      "classifications": [
        "mpa.r",
        "bbfc.fifteen",
        "cbfc.a",
        "fsk.fsk_16",
        "acb.ma_15"
      ],
      "confidence": "low",
      "note": "The adult and near-adult tiers diverge most. FSK is comparatively tolerant of sexual content and comparatively strict on glorified violence; CBFC A remains more restricted on sexual content than any of the others; BBFC 15 admits a younger audience than MPA R."
    },
    {
      "classifications": [
        "mpa.nc_17",
        "bbfc.eighteen",
        "fsk.fsk_18",
        "acb.r_18"
      ],
      "confidence": "medium",
      "note": "Adults-only tiers align in permitted content, but NC-17 carries distribution and advertising consequences in the United States that the others do not. CBFC has no equivalent: India's most permissive classification is A."
    }
  ]
