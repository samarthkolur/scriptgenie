            "language": 1,
            "thematic_darkness": 2,
            "drug_use": 1,
            "horror_intensity": 2
          },
          "criteria": {
            "violence": "Brief, non-graphic conflict; consequences are implied rather than shown.",
            "sexual_content": "Mild references; no nudity.",
            "language": "Mild expletives only.",
            "thematic_darkness": "Difficult themes permitted where handled without sustained bleakness.",
            "drug_use": "Passing reference only; no depiction of use.",
            "horror_intensity": "Sustained suspense permitted; no sustained dread."
          }
        },
