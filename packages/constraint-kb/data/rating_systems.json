            "sexual_content": 0,
            "language": 0,
            "thematic_darkness": 1,
            "drug_use": 0,
            "horror_intensity": 1
          },
          "criteria": {
            "violence": "Only minimal, non-realistic conflict with no depicted injury.",
            "sexual_content": "None.",
            "language": "No profanity beyond the mildest everyday expressions.",
            "thematic_darkness": "Themes must be resolvable and reassuring; peril is brief.",
            "drug_use": "No depiction of drug use.",
            "horror_intensity": "Momentary scares only, with immediate relief."
          },
          "prohibited_elements": [
            "nudity",
            "sex scenes",
            "drug use",
            "explicit language"
          ]
        },
        {
