# Copy to `.env` and fill in. Never commit the filled-in file.
# Only variables the application actually reads are listed here; each stage
# that introduces a new dependency adds its variables to this file.

# development | test | production
APP_ENV=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Comma-separated browser origins permitted to call this API.
ALLOWED_ORIGINS=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# Project URL, from Settings -> API. Also determines the JWT issuer this service
# accepts and the JWKS it verifies against, so a wrong value here rejects every
# token with "token was issued by a different project".
SUPABASE_URL=

# The anon public key. Public by design — it is in the browser bundle too. Sent
# as the `apikey` header on every user request; the user's own access token is
# what goes in `Authorization`, which is what makes row level security apply.
SUPABASE_ANON_KEY=

# The service role key. THIS IS A SECRET AND IT BYPASSES ROW LEVEL SECURITY.
# Used for exactly one thing: writing usage_events, which no client may write.
# It must never appear in apps/web, where it would ship to every visitor.
SUPABASE_SERVICE_ROLE_KEY=

# Only for projects still on Supabase's legacy symmetric signing keys. When set,
# access tokens are verified with HS256 against this secret instead of against
# the project's published JWKS. Leave blank on any project created recently.
SUPABASE_JWT_SECRET=

# Defaults in app/core/config.py, shown commented out for the same reason as the
# Groq block below: an uncommented empty value overrides the default with an
# empty string.
#
# How long a fetched JWKS is trusted, and the floor between refetches triggered
# by an unknown key id. The floor is what stops a token carrying a random `kid`
# turning every request into an outbound fetch.
# SUPABASE_JWKS_CACHE_SECONDS=600
# SUPABASE_JWKS_MIN_REFRESH_SECONDS=30
# SUPABASE_TIMEOUT_SECONDS=10

# --- Limits and quotas ------------------------------------------------------
# All have working defaults; shown commented out for the same reason as the
# blocks below.
#
# Generation runs one user may start per rolling window. Counted in the
# database over generation_runs, so the limit holds across every instance and
# survives a restart. Set to 0 to disable it entirely.
# RATE_LIMIT_GENERATIONS_PER_WINDOW=10
# RATE_LIMIT_WINDOW_SECONDS=3600
#
# Largest request body accepted, in bytes. Every legitimate request is a
# constraint bundle and a few resolution ids, so the default is generous by two
# orders of magnitude and still refuses a body that would be buffered before
# anything could reject it.
# MAX_REQUEST_BYTES=262144

# --- Groq -------------------------------------------------------------------
# Required before any generation call. Create one at
# https://console.groq.com/keys.
GROQ_API_KEY=

# Everything below has a working default in app/core/config.py. The defaults are
# shown for reference and left commented out on purpose: an uncommented empty
# value would override the default with an empty string, which is worse than
# not setting it at all.
#
# openai/gpt-oss-120b is the production model supporting strict JSON-schema
# constrained decoding; the Llama models offer json_object only. Free-tier
# limits are identical across them (30 RPM / 8K TPM / 1K RPD).
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
#
# Per-attempt timeout, and the ceiling on one logical request including every
# retry and backoff. The deadline is what stops a 5xx storm hanging a caller.
# GROQ_TIMEOUT_SECONDS=30
# GROQ_DEADLINE_SECONDS=60
# GROQ_MAX_RETRIES=3
#
# Ceiling on this process's simultaneous outbound model calls. One five-variant
# generation makes ten — five variants and five verification extractions — so
# this bounds how many users generate at once before requests queue rather than
# collecting provider 429s. Under N instances the effective cap is N times this.
# GROQ_MAX_CONCURRENCY=8
#
# Consecutive failed attempts before the circuit opens, and how long it stays
# open before one trial request is allowed through.
# GROQ_BREAKER_THRESHOLD=5
# GROQ_BREAKER_COOLDOWN_SECONDS=30
