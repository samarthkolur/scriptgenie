# Copy to `.env` and fill in. Never commit the filled-in file.
# Only variables the application actually reads are listed here; each stage
# that introduces a new dependency adds its variables to this file.

# development | test | production
APP_ENV=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Comma-separated browser origins permitted to call this API.
ALLOWED_ORIGINS=http://localhost:3000
